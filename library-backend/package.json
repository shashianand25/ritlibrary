		"eslint": "^9.25.0",
		"globals": "^16.0.0",
		"prettier": "^3.9.6",
		"vitest": "3.2.7",
		"wrangler": "^4.123.0"
	},
	"dependencies": {
		"@neondatabase/serverless": "^1.1.0",
		"@sentry/cloudflare": "^10.70.0",
		"firebase": "^12.13.0",
		"pino": "^10.3.1",
		"zod": "^3.24.2"
	},
	"coverageThreshold": {
		"global": {
			"lines": 70,
			"functions": 70,
