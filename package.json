{
  "name": "ritlibrary-monorepo",
  "version": "1.3.0",
  "type": "module",
  "private": true,
  "description": "RIT Library - Academic resource portal with notes, PYQs, and syllabus tracking",
  "workspaces": [
    "my-project",
    "library-backend"
  ],
  "dependencies": {
    "library-backend": "*",
    "my-project": "*"
  },
  "scripts": {
    "setup": "npm install && node scripts/setup.js",
    "dev": "npm --prefix my-project run dev",
    "build": "npm --prefix my-project run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "npm --prefix my-project run typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:deps": "npm audit --audit-level=critical"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.25.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.6",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "tar": "^7.5.22",
    "@mapbox/node-pre-gyp": {
      "tar": "^7.5.22"
    },
    "undici": ">=7.28.1",
    "ws": ">=8.20.2",
    "sharp": ">=0.35.0",
    "esbuild": ">=0.28.1"
  },
  "coverageThreshold": {
    "global": {
      "lines": 70,
      "functions": 70,
      "branches": 65,
      "statements": 70
    }
  },
  "author": "RIT Library Team",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/shashianand25/ritlibrary"
  }
}
