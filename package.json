{
  "name": "ritlibrary-monorepo",
  "version": "1.1.0",
  "private": true,
  "description": "RIT Library - Academic resource portal with notes, PYQs, and syllabus tracking",
  "workspaces": [
    "my-project",
    "library-backend"
  ],
  "scripts": {
    "dev": "npm --prefix my-project run dev",
    "build": "npm --prefix my-project run build",
    "test": "npm --prefix my-project run test:coverage && npm --prefix library-backend test",
    "test:coverage": "npm --prefix my-project run test:coverage",
    "typecheck": "npm --prefix my-project run typecheck",
    "lint": "npm --prefix my-project run lint",
    "format": "npm --prefix my-project run format",
    "format:check": "npm --prefix my-project run format:check"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.5",
    "framer-motion": "^12.12.2",
    "lucide-react": "^0.511.0"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "author": "RIT Library Team",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/shashianand25/ritlibrary"
  }
}
